# Local secrets — never committed (workspace Rule 4)
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Local Worker state
.wrangler/

# Generated by `wrangler types` on postinstall — regenerated from wrangler.toml rather than
# committed, so it can never be stale relative to the config it describes.
worker-configuration.d.ts

# Test output
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log
