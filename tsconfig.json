{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",

    // Workers runtime types come from `worker-configuration.d.ts`, generated by
    // `wrangler types` on postinstall — it supersedes `@cloudflare/workers-types` and derives
    // the global `Env` from wrangler.toml, so bindings cannot drift from configuration.
    //
    // `@types/node` is here only because `nodejs_compat_v2` makes it true: the `mongodb`
    // driver's own types import from `net` and `tls`, so without it every option type on
    // `MongoClientOptions` collapses. It is not a licence to use Node APIs freely — workerd is
    // what runs this code, and only the subset `nodejs_compat_v2` implements exists at runtime.
    "types": ["@cloudflare/vitest-pool-workers/types", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "noEmit": true
  },
  "include": ["src", "test", "*.config.ts", "worker-configuration.d.ts"]
}
