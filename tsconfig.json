{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",

    // Workers runtime types come from `worker-configuration.d.ts`, generated by
    // `wrangler types` on postinstall — it supersedes `@cloudflare/workers-types` and derives
    // the global `Env` from wrangler.toml, so bindings cannot drift from configuration.
    "types": ["@cloudflare/vitest-pool-workers/types"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "noEmit": true
  },
  "include": ["src", "test", "*.config.ts", "worker-configuration.d.ts"]
}
