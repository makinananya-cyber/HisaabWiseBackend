{
  "name": "hisaabwise-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:sync": "node scripts/sync-contract-corpus.mjs",
    "content:extract": "node scripts/extract-content.mjs",
    "content:check": "node scripts/extract-content.mjs --check",
    "seed:fx": "node --env-file-if-exists=.env scripts/seed-fx.mjs",
    "verify:db": "bash scripts/verify-db.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "argon2": "^0.45.1",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "mongodb": "^6.21.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "argon2": true,
    "@phc/format": true,
    "node-addon-api": true
  }
}
