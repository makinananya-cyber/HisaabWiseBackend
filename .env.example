# Local configuration for `npm run dev`. Copy to `.env` and fill in what you need.
#
# `.env` is gitignored and must stay that way. In staging and production these same variables are
# set as environment secrets on the host, never committed. Every variable from Technical Spec §7 is
# listed here so a new developer does not have to reverse-engineer them from the code; where a
# default exists it is named in the comment rather than filled in.
#
# Only MONGODB_URI is required to boot. The rest are read by the slice that needs them, and
# `requireSecret` fails loudly with the variable named if one is missing when it matters.

NODE_ENV=development
# Default: 8080
PORT=
# Default: info — one of fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=

# ── Database ──────────────────────────────────────────────────────────────────────────────────
# Required, and it MUST name the database in its path. A URI ending at `mongodb.net/` silently
# resolves to a database called `test`, so the server refuses to boot without one.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hisaabwise_dev?retryWrites=true&w=majority
# Never a production URI on a local machine (workspace Rule 4).
MONGODB_URI=
# Default: 10. One shared pool for the process; lower it if Atlas connection counts climb.
MONGODB_MAX_POOL_SIZE=

# ── Auth ──────────────────────────────────────────────────────────────────────────────────────
# Access-token signing (jose). At least 32 characters. Refresh tokens are opaque CSPRNG values
# stored as SHA-256 hashes, so there is no refresh-signing secret.
JWT_ACCESS_SECRET=
# Defaults: 15m / 60d
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=

# argon2id parameters, tunable without a code change. Measured at 23 ms hash / 21 ms verify on
# Node at the defaults. If cost must rise, raise the time cost — never lower the memory cost.
# Defaults: 19456 KiB / time cost 2
ARGON2_MEMORY_KIB=
ARGON2_TIME_COST=

# ── FX rate feed ──────────────────────────────────────────────────────────────────────────────
# Base is the USD pivot — default USD.
FX_PROVIDER_API_KEY=
FX_BASE_CURRENCY=

# ── Apple push ────────────────────────────────────────────────────────────────────────────────
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ── Error reporting ───────────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS ──────────────────────────────────────────────────────────────────────────────────────
# Marketing site only; the iOS client needs none. Comma-separated. Empty allows nothing.
CORS_ORIGINS=

# ── Application-level rate limiting ───────────────────────────────────────────────────────────
# Defaults: 60000 ms window / 100 requests
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
